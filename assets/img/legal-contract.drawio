        <mxCell id="MZKCZYfSjLcLGuovCye_-17" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#222222;fontFamily=Menlo, SFMono-Regular, monospace;fontFamily=Inter, Apple SD Gothic Neo, Noto Sans KR, Helvetica;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&quot;소송 구분&quot;: &lt;font color=&quot;#c62828&quot;&gt;&quot;민사&quot;&lt;/font&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&quot;심급&quot;: &lt;font color=&quot;#c62828&quot;&gt;&quot;&quot;&lt;/font&gt;&lt;br&gt;&quot;사건 종류&quot;: &lt;font color=&quot;#c62828&quot;&gt;&quot;대여금 청구&quot;&lt;/font&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &quot;피고 수&quot;: &lt;font color=&quot;#c62828&quot;&gt;&quot;&quot;&lt;/font&gt;&lt;br&gt;&quot;소가&quot;: &lt;font color=&quot;#c62828&quot;&gt;&quot;&quot;&lt;/font&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&quot;변호사 보수&quot;: &lt;font color=&quot;#c62828&quot;&gt;&quot;&quot;&lt;/font&gt;&lt;/font&gt;" vertex="1">
